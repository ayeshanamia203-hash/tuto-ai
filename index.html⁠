function handleFileSelect(input){

    if(
        !input.files ||
        !input.files[0]
    ) return;

    selectedFile =
        input.files[0];


    const previewArea =
        document.getElementById(
            "filePreviewArea"
        );

    const imageThumb =
        document.getElementById(
            "previewImgThumb"
        );

    const pdfThumb =
        document.getElementById(
            "pdfPreviewThumb"
        );


    if(
        selectedFile.type ===
        "application/pdf"
    ){

        imageThumb.style.display =
            "none";

        pdfThumb.style.display =
            "inline-block";

        document.getElementById(
            "pdfFileName"
        ).innerText =
            selectedFile.name;

    }else{

        pdfThumb.style.display =
            "none";

        imageThumb.style.display =
            "block";

        imageThumb.src =
            URL.createObjectURL(
                selectedFile
            );
    }


    previewArea.style.display =
        "block";
}


function clearSelectedFile(){

    selectedFile = null;

    document.getElementById(
        "galleryInput"
    ).value = "";

    document.getElementById(
        "cameraInput"
    ).value = "";

    document.getElementById(
        "pdfInput"
    ).value = "";

    document.getElementById(
        "filePreviewArea"
    ).style.display = "none";

    document.getElementById(
        "previewImgThumb"
    ).src = "";
}


/* =====================================================
   TEXT TO SPEECH
===================================================== */

function speakText(button){

    if(
        !("speechSynthesis" in window)
    ){

        alert(
            "Voice output is not supported."
        );

        return;
    }


    const bubble =
        button.closest(".bubble");

    let text =
        bubble
        ? bubble.innerText
        : "";


    if(
        window.speechSynthesis.speaking
    ){

        window.speechSynthesis.cancel();

        button.innerHTML =
            '<i class="fa-solid fa-volume-high"></i>';

        return;
    }


    const utterance =
        new SpeechSynthesisUtterance(
            text
        );


    if(
        /[\u0980-\u09FF]/.test(text)
    ){

        utterance.lang =
            "bn-BD";

    }else{

        utterance.lang =
            "en-US";
    }


    button.innerHTML =
        '<i class="fa-solid fa-volume-xmark text-warning"></i>';


    utterance.onend =
        () => {

            button.innerHTML =
                '<i class="fa-solid fa-volume-high"></i>';

        };


    window.speechSynthesis.speak(
        utterance
    );
}


/* =====================================================
   SEND MESSAGE
===================================================== */

document
    .getElementById("chatForm")
    .addEventListener(
        "submit",
        async function(e){

            e.preventDefault();


            const sendBtn =
                document.getElementById(
                    "sendBtn"
                );


            const question =
                questionInput.value.trim();


            if(
                !question &&
                !selectedFile
            ){

                return;
            }


            /* Remove welcome */

            const welcome =
                document.getElementById(
                    "welcomeScreen"
                );

            if(welcome){

                chatBox.innerHTML =
                    "";

            }


            /* User message */

            let userHTML = "";


            if(question){

                userHTML += `

                    <strong>You</strong><br>

                    ${escapeHTML(question)
                        .replace(/\n/g,"<br>")}

                `;

            }


            if(selectedFile){

                if(
                    selectedFile.type ===
                    "application/pdf"
                ){

                    userHTML =
                        `<div class="pdf-badge">
                            <i class="fa-solid fa-file-pdf"></i>
                            ${escapeHTML(selectedFile.name)}
                        </div>` +
                        (
                            userHTML
                            ? "<br>" + userHTML
                            : ""
                        );

                }else{

                    const url =
                        URL.createObjectURL(
                            selectedFile
                        );

                    userHTML =
                        `<img
                            src="${url}"
                            class="uploaded-img-preview"
                        >` +
                        (
                            userHTML
                            ? "<br>" + userHTML
                            : ""
                        );
                }
            }


            chatBox.innerHTML += `

                <div class="message">

                    <div class="avatar user-avatar">
                        You
                    </div>

                    <div class="bubble">
                        ${userHTML}
                    </div>

                </div>

            `;


            /* FormData */

            const formData =
                new FormData();

            formData.append(
                "question",
                question
            );

            formData.append(
                "session_id",
                currentSessionId
            );


            if(selectedFile){

                formData.append(
                    "file",
                    selectedFile
                );

            }


            questionInput.value = "";

            questionInput.style.height =
                "auto";


            clearSelectedFile();


            sendBtn.disabled =
                true;


            chatBox.scrollTop =
                chatBox.scrollHeight;


            /* Loading */

            const loadingId =
                "loading-" +
                Date.now();


            chatBox.innerHTML += `

                <div
                    class="message"
                    id="${loadingId}"
                >

                    <div class="avatar ai-avatar">
                        AI
                    </div>

                    <div class="bubble text-secondary">

                        <i class="fa-solid fa-circle-notch fa-spin me-2"></i>

                        Thinking...

                    </div>

                </div>

            `;


            chatBox.scrollTop =
                chatBox.scrollHeight;


            try{

                const response =
                    await fetch(
                        "/api/chat",
                        {
                            method:"POST",
                            body:formData
                        }
                    );


                const data =
                    await response.json();


                const loading =
                    document.getElementById(
                        loadingId
                    );


                if(
                    data.status ===
                    "success"
                ){

                    let content =
                        data.response || "";


                    try{

                        content =
                            marked.parse(
                                content
                            );

                    }catch(e){

                        content =
                            escapeHTML(
                                data.response
                            ).replace(
                                /\n/g,
                                "<br>"
                            );
                    }


                    const bubble =
                        loading.querySelector(
                            ".bubble"
                        );


                    bubble.innerHTML = `

                        <div class="d-flex justify-content-between align-items-center mb-1">

                            <strong>
                                Tuto AI
                            </strong>

                            <button
                                class="tts-btn"
                                onclick="speakText(this)"
                                title="Read Aloud"
                            >

                                <i class="fa-solid fa-volume-high"></i>

                            </button>

                        </div>


                        <div>
                            ${content}
                        </div>

                    `;


                    processCodeBlocks(
                        bubble
                    );

                    renderMath(
                        bubble
                    );


                    allSessions[
                        currentSessionId
                    ].html =
                        chatBox.innerHTML;


                    saveSessions();


                    /* Generate title */

                    if(
                        allSessions[
                            currentSessionId
                        ].title ===
                        "New Chat"
                    ){

                        generateTitle(
                            question ||
                            selectedFile?.name ||
                            "Conversation"
                        );

                    }

                }else{

                    loading.querySelector(
                        ".bubble"
                    ).innerHTML = `

                        <span class="text-danger">

                            Error:
                            ${escapeHTML(
                                data.message ||
                                "Something went wrong."
                            )}

                        </span>

                    `;

                }


            }catch(error){

                const loading =
                    document.getElementById(
                        loadingId
                    );


                if(loading){

                    loading.querySelector(
                        ".bubble"
                    ).innerHTML = `

                        <span class="text-danger">

                            Server connection error.

                        </span>

                    `;

                }

            }finally{

                sendBtn.disabled =
                    false;

                chatBox.scrollTop =
                    chatBox.scrollHeight;

            }

        }
    );


/* =====================================================
   SMART TITLE
===================================================== */

async function generateTitle(prompt){

    try{

        const response =
            await fetch(
                "/api/generate-title",
                {
                    method:"POST",

                    headers:{
                        "Content-Type":
                            "application/json"
                    },

                    body:JSON.stringify({
                        prompt:prompt
                    })
                }
            );


        const data =
            await response.json();


        if(
            data.status === "success" &&
            data.title &&
            allSessions[
                currentSessionId
            ]
        ){

            allSessions[
                currentSessionId
            ].title =
                data.title;

            saveSessions();

            renderSidebarHistory();

        }

    }catch(error){}

}

