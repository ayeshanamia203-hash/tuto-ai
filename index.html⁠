</div>

<!-- ================= MAIN ================= -->

<div class="main-chat">

    <div class="chat-header">

        <div class="header-left">

            <button class="toggle-btn"
                    onclick="toggleSidebar()"
                    title="Toggle Sidebar">

                <i class="fa-solid fa-bars"></i>

