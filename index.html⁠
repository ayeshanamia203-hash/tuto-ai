<!-- Tuto Frontend -->
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

    <title>Tuto AI</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- KaTeX -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js"></script>

    <!-- Markdown -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    <!-- Highlight.js -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/atom-one-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/highlight.min.js"></script>

    <style>
        :root[data-theme="dark"] {
            --bg-color: #131314;
            --sidebar-bg: #1e1e20;
            --text-color: #ffffff;
            --text-muted: #b8b8b8;
            --accent-color: #a8c7fa;
            --border-color: #2d2d30;
            --input-bg: #1e1e20;
            --input-border: #3c4043;
            --btn-hover: #2b2a33;
            --bubble-text: #ffffff;
            --strong-color: #a8c7fa;
            --modal-bg: #1e1e20;
        }

        :root[data-theme="light"] {
            --bg-color: #ffffff;
            --sidebar-bg: #f0f4f9;
            --text-color: #1f1f1f;
            --text-muted: #555555;
            --accent-color: #0b57d0;
            --border-color: #e1e3e1;
            --input-bg: #f0f4f9;
            --input-border: #c4c7c5;
            --btn-hover: #e3e3e3;
            --bubble-text: #1f1f1f;
            --strong-color: #0b57d0;
            --modal-bg: #ffffff;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: var(--bg-color);
            color: var(--text-color);
            font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
        }

        body {
            display: flex;
        }

        /* ================= SIDEBAR ================= */

        .sidebar {
            width: 260px;
            height: 100%;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
            padding: 20px;
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            transition: all 0.3s ease;
            z-index: 1000;
        }

        .sidebar.collapsed {
            margin-left: -260px;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.5);
            z-index: 999;
        }

        .new-chat-btn {
            background: var(--input-bg);
            color: var(--text-color);
            border: 1px solid var(--border-color);
            border-radius: 30px;
            padding: 10px 15px;
            font-weight: 500;
            transition: .2s;
        }

        .new-chat-btn:hover {
            background: var(--btn-hover);
        }

        .history-list {
            flex: 1;
            overflow-y: auto;
            margin-top: 15px;
            margin-bottom: 15px;
        }

        .history-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
            border-radius: 10px;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 14px;
            margin-bottom: 5px;
            user-select: none;
            position: relative;
        }

        .history-item:hover,
        .history-item.active {
            background: var(--btn-hover);
            color: var(--text-color);
        }

        .history-title {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 150px;
        }

        .action-btns-group {
            display: none;
            align-items: center;
            gap: 6px;
        }

        .history-item.show-actions .action-btns-group {
            display: flex;
        }

        .action-icon-btn {
            border: none;
            background: transparent;
            font-size: 13px;
            cursor: pointer;
            padding: 2px 4px;
        }

        .delete-btn-icon {
            color: #e11d48;
        }

        .star-btn-icon {
            color: #f59e0b;
        }

        .is-pinned-icon {
            color: #f59e0b;
            font-size: 12px;
            margin-left: 4px;
        }

        /* ================= MAIN ================= */

        .main-chat {
            flex: 1;
            width: 100%;
            height: 100vh;
            height: 100dvh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .chat-header {
            padding: 15px 25px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
        }

        .header-left {
            display: flex;
            align-items: center;
        }

        .toggle-btn,
        .theme-btn {
            background: transparent;
            border: none;
            color: var(--text-color);
            cursor: pointer;
            padding: 7px 12px;
            border-radius: 20px;
        }

        .toggle-btn:hover,
        .theme-btn:hover {
            background: var(--btn-hover);
        }

        .theme-btn {
            border: 1px solid var(--border-color);
            font-size: 14px;
        }

        /* ================= CHAT ================= */

        .chat-container {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            width: 100%;
            max-width: 900px;
            margin: 0 auto;
        }

        .welcome-screen {
            min-height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            text-align: center;
        }

        .welcome-avatar {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            background: linear-gradient(135deg,#f59e0b,#d97706);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 22px;
            margin-bottom: 15px;
        }

        .message {
            display: flex;
            gap: 15px;
            margin-bottom: 28px;
        }

        .avatar {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-shrink: 0;
            font-size: 13px;
            font-weight: bold;
        }

        .user-avatar {
            background: #5436da;
            color: white;
        }

        .ai-avatar {
            background: linear-gradient(135deg,#f59e0b,#d97706);
            color: white;
        }

        .bubble {
            width: 100%;
            max-width: 88%;
            color: var(--bubble-text);
            font-size: 16px;
            line-height: 1.65;
            word-wrap: break-word;
        }

        .bubble strong {
            color: var(--strong-color);
        }

        .bubble table {
            width: 100%;
            border-collapse: collapse;
            margin: 12px 0;
        }

        .bubble th,
        .bubble td {
            border: 1px solid var(--border-color);
            padding: 8px;
        }

        .bubble th {
            background: var(--btn-hover);
        }

        /* ================= CODE ================= */

        .code-container {
            margin: 12px 0;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid #3e4451;
            background: #282c34;
        }

        .code-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #21252b;
            padding: 6px 12px;
            font-size: 12px;
            color: #abb2bf;
        }

        pre {
            margin: 0 !important;
            padding: 12px !important;
            overflow-x: auto;
        }

        .copy-code-btn {
            background: #3e4451;
            color: white;
            border: none;
            border-radius: 4px;
            padding: 3px 8px;
            font-size: 12px;
            cursor: pointer;
        }

        /* ================= FILE PREVIEW ================= */

        .uploaded-img-preview {
            max-width: 220px;
            border-radius: 10px;
            border: 1px solid var(--border-color);
            margin-bottom: 8px;
        }

        .pdf-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--btn-hover);
            border: 1px solid #e11d48;
            color: #ff4d4d;
            padding: 7px 12px;
            border-radius: 8px;
        }

        /* ================= INPUT ================= */

        .input-container-box {
            width: 100%;
            padding: 10px 15px 15px;
            background: var(--bg-color);
            flex-shrink: 0;
        }

        .input-wrapper {
            width: 100%;
            max-width: 850px;
            margin: 0 auto;
            background: var(--input-bg);
            border: 1px solid var(--input-border);
            border-radius: 24px;
            padding: 8px 15px;
        }

        #filePreviewArea {
            display: none;
            position: relative;
            width: fit-content;
            margin-bottom: 8px;
        }

        #previewImgThumb {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 12px;
        }

        #pdfPreviewThumb {
            display: none;
            background: var(--btn-hover);
            border: 1px solid #e11d48;
            color: #ff4d4d;
            padding: 8px 12px;
            border-radius: 10px;
            font-size: 13px;
        }

        .close-img-btn {
            position: absolute;
            top: -7px;
            right: -7px;
            width: 22px;
            height: 22px;
            border: none;
            border-radius: 50%;
            background: #e11d48;
            color: white;
            cursor: pointer;
        }

        .input-row {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .plus-btn,
        .mic-btn {
            background: none;
            border: none;
            color: var(--accent-color);
            font-size: 18px;
            cursor: pointer;
            padding: 5px;
        }

        .mic-btn.recording {
            color: #ef4444 !important;
            animation: pulse 1.2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.2); }
            100% { transform: scale(1); }
        }

        .chat-textarea {
            background: transparent;
            border: none;
            outline: none;
            color: var(--text-color);
            width: 100%;
            resize: none;
            min-height: 28px;
            max-height: 120px;
            padding: 6px 0;
            font-size: 15px;
            font-family: inherit;
        }

        .send-btn {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: none;
            background: var(--text-color);
            color: var(--bg-color);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            flex-shrink: 0;
        }

        .send-btn:disabled {
            background: var(--border-color);
            color: var(--text-muted);
            cursor: not-allowed;
        }

        .tts-btn {
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
        }

        /* ================= MODAL ================= */

        .modal-content {
            background: var(--modal-bg);
            color: var(--text-color);
            border: 1px solid var(--border-color);
        }

        .modal-btn {
            width: 100%;
            padding: 15px;
            margin-bottom: 10px;
            border-radius: 15px;
            border: 1px solid var(--border-color);
            background: var(--input-bg);
            color: var(--text-color);
            text-align: left;
        }

        .modal-btn:hover {
            background: var(--btn-hover);
        }

        @media(max-width:768px) {
            .sidebar {
                position: absolute;
                top: 0;
                bottom: 0;
                left: 0;
                box-shadow: 5px 0 15px rgba(0,0,0,.3);
            }

            .sidebar.collapsed {
                margin-left: -260px;
            }

            .sidebar-overlay.active {
                display: block;
            }

            .chat-container {
                padding: 15px 10px;
            }

            .chat-header {
                padding: 12px 15px;
            }
        }
    </style>
</head>

<body>

<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

<!-- ================= SIDEBAR ================= -->

<div class="sidebar" id="sidebar">

    <div class="d-flex justify-content-between align-items-center mb-3 d-md-none">
        <span class="fw-bold">Menu</span>
        <button class="btn btn-sm text-secondary" onclick="toggleSidebar()">
